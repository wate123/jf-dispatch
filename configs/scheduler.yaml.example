version: 1

scheduler:
  listen: "0.0.0.0:7000"
  address: "home-server:7000"

metrics:
  enabled: true
  listen: "0.0.0.0:9090"

storage:
  media_paths: ["/media"]
  transcode_path: "/transcode"

security:
  token_file: "/etc/jf-dispatch/cluster-token"
  allowed_paths: ["/media", "/transcode"]
  allow_environment: false
